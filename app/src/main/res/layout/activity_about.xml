<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="40dp">

            <!-- 顶部返回 + 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/aboutBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textSize="28sp"
                    android:padding="8dp"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/aboutTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:textColor="#000000" />

            </LinearLayout>

            <!-- App 图标 -->
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_app"
                android:contentDescription="App 图标" />

            <!-- App 名 -->
            <TextView
                android:id="@+id/aboutAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="倒计时15秒"
                android:textSize="20sp"
                android:textColor="#000000" />

            <!-- 版本号 -->
            <TextView
                android:id="@+id/aboutAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="v0.0.1"
                android:textSize="14sp"
                android:textColor="#999999" />

            <!-- 开源代码 -->
            <TextView
                android:id="@+id/itemOpenSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="18dp"
                android:layout_marginTop="40dp"
                android:text="开源代码"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="?android:attr/selectableItemBackground" />

            <!-- 问题反馈 -->
            <TextView
                android:id="@+id/itemFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="18dp"
                android:text="问题反馈"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="?android:attr/selectableItemBackground" />

            <!-- 导出日志 -->
            <TextView
                android:id="@+id/itemExportLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="18dp"
                android:text="导出日志"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="?android:attr/selectableItemBackground" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>